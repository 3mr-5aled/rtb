{
  "name": "@3mr5aled/rtb",
  "version": "0.13.5",
  "description": "Unified workspace & project manager CLI",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rtb": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3mr-5aled/rtb.git",
    "directory": "core"
  },
  "homepage": "https://github.com/3mr-5aled/rtb#readme",
  "bugs": {
    "url": "https://github.com/3mr-5aled/rtb/issues"
  },
